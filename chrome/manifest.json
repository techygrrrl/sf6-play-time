{
  "name": "sf6-play-time",
  "version": "0.0.2",
  "description": "Street Fighter 6 Buckler play time display. Load a profile page and see the play time numbers under the existing chart.",
  "icons": {
    "16": "icon-162.png",
    "32": "icon-162.png",
    "48": "icon-162.png",
    "128": "icon-162.png"
  },
  "background": {
    "service_worker": "./background.js",
    "type": "module"
  },
  "action": {
    "default_icon": "icon-162.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [],
  "manifest_version": 3
}
